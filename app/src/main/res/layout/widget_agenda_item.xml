<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="2dp"
    android:paddingTop="2dp">

    <!-- Day group header (e.g. TODAY, TOMORROW, SAT OCT 31) -->
    <RelativeLayout
        android:id="@+id/widget_item_date_header_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_item_date_header_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/widget_item_date_header"
            android:layout_alignEnd="@id/widget_item_date_header"
            android:layout_alignStart="@id/widget_item_date_header"
            android:layout_alignTop="@id/widget_item_date_header"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_chip_fill" />

        <TextView
            android:id="@+id/widget_item_date_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="3dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:text="TODAY"
            android:textColor="#1A73E8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Event Item Card with rounded background and stroke layers -->
    <RelativeLayout
        android:id="@+id/widget_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_item_bg_fill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/widget_item_content"
            android:layout_alignTop="@id/widget_item_content"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_item_fill" />

        <ImageView
            android:id="@+id/widget_item_bg_stroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/widget_item_content"
            android:layout_alignTop="@id/widget_item_content"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_item_stroke" />

        <RelativeLayout
            android:id="@+id/widget_item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <!-- Rounded color strip indicator aligned to stacked text height -->
            <ImageView
                android:id="@+id/widget_item_color_bar"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/widget_item_text_column"
                android:layout_alignParentStart="true"
                android:layout_alignTop="@id/widget_item_text_column"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:minHeight="28dp"
                android:scaleType="fitXY"
                android:src="@drawable/widget_color_bar_shape" />

            <RelativeLayout
                android:id="@+id/widget_item_cue_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/widget_item_text_column"
                android:layout_marginStart="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_item_cue_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/widget_item_cue_text"
                    android:layout_alignEnd="@id/widget_item_cue_text"
                    android:layout_alignStart="@id/widget_item_cue_text"
                    android:layout_alignTop="@id/widget_item_cue_text"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_chip_fill" />

                <TextView
                    android:id="@+id/widget_item_cue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingBottom="2dp"
                    android:paddingEnd="6dp"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:text="@string/widget_badge_now"
                    android:textColor="#1A73E8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/widget_item_text_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/widget_item_color_bar"
                android:layout_toStartOf="@id/widget_item_cue_container"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:text="Event Title"
                    android:textColor="#1F1F1F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="10:00 AM"
                    android:textColor="#1A73E8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Google Calendar"
                    android:textColor="#5F6368"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_item_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Google Meet / Room"
                    android:textColor="#5F6368"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
