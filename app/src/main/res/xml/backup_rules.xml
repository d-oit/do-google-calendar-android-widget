<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-preserving backup rules for Android 11 and lower.
   Includes non-sensitive widget appearance preferences while strictly excluding
   the local Room cache of private calendar events.
-->
<full-backup-content>
    <include domain="sharedpref" path="google_calendar_widget_prefs.xml" />
    <exclude domain="database" path="calendar_widget_db" />
    <exclude domain="database" path="calendar_widget_db-wal" />
    <exclude domain="database" path="calendar_widget_db-shm" />
</full-backup-content>
