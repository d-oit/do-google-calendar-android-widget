<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-preserving data extraction rules for Android 12+ (API 31+).
   Excludes cached personal calendar events from cloud backups and device transfers
   while preserving non-sensitive widget customization preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="google_calendar_widget_prefs.xml" />
        <exclude domain="database" path="calendar_widget_db" />
        <exclude domain="database" path="calendar_widget_db-wal" />
        <exclude domain="database" path="calendar_widget_db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="google_calendar_widget_prefs.xml" />
        <exclude domain="database" path="calendar_widget_db" />
        <exclude domain="database" path="calendar_widget_db-wal" />
        <exclude domain="database" path="calendar_widget_db-shm" />
    </device-transfer>
</data-extraction-rules>
